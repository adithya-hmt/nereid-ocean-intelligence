+++ b/web/src/lib/webgl.ts
@@ -0,0 +1,4 @@
+export function hasWebGLSupport(documentRef: Document = document): boolean {
+  const canvas = documentRef.createElement('canvas')
+  return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'))
+}
